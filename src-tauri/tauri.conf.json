{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aerie",
  "version": "0.1.0",
  "identifier": "dev.sunlight.game-engine-editor",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aerie",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [
      "../zig-out/bin/game_engine",
      "../build.zig",
      "../build.zig.zon",
      "../src",
      "../web",
      "../.tools/zig-aarch64-macos-0.16.0"
    ]
  }
}
